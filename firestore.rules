rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Registro de eventos del juego: cualquiera puede leer y agregar,
    // pero nadie puede modificar ni borrar lo que ya pasó.
    match /games/{game}/events/{eventId} {
      allow read: if true;
      allow create: if request.resource.data.id == eventId
                    && request.resource.data.type is string
                    && request.resource.data.ts is number
                    && request.resource.data.size() < 20;
      allow update, delete: if false;
    }
    // Ubicación de cada equipo: un documento por equipo, CIFRADO
    // (solo el panel con el PIN de admin puede leer las coordenadas).
    match /games/{game}/presence/{teamId} {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['teamId', 'enc', 'ts'])
                            && request.resource.data.teamId == teamId
                            && request.resource.data.enc is string
                            && request.resource.data.enc.size() < 1000
                            && request.resource.data.ts is number;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
